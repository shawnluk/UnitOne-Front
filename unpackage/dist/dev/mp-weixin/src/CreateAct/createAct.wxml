<view wx:if="{{a}}" class="activity-modal"><view class="modal-content"><view class="modal-header"><text class="modal-title">发布活动</text><text class="modal-close" bindtap="{{b}}">✕</text></view><view class="activity-cover-section"><view class="cover-placeholder" bindtap="{{c}}"><text class="cover-icon">📷</text><text class="cover-text">添加活动封面</text></view></view><view class="activity-form"><view class="form-item"><text class="form-label">活动标题</text><input class="form-input" placeholder="请输入活动标题" value="{{d}}" bindinput="{{e}}"/></view><view class="form-item"><text class="form-label">活动类型</text><view class="form-select" bindtap="{{g}}"><text>{{f}}</text><text class="select-arrow">▼</text></view></view><view class="form-item"><text class="form-label">活动时间</text><view class="form-select" bindtap="{{i}}"><text>{{h}}</text><text class="select-arrow">▼</text></view></view><view class="form-item"><text class="form-label">活动地点</text><input class="form-input" placeholder="请输入活动地点" value="{{j}}" bindinput="{{k}}"/></view><view class="form-item"><text class="form-label">活动费用</text><input class="form-input" placeholder="请输入活动费用" type="number" value="{{l}}" bindinput="{{m}}"/></view><view class="form-item"><text class="form-label">活动描述</text><block wx:if="{{r0}}"><textarea class="form-textarea" placeholder="请详细描述活动内容" rows="4" value="{{n}}" bindinput="{{o}}"></textarea></block></view></view><button class="submit-btn" bindtap="{{p}}">发布活动</button></view></view>